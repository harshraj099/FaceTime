# Stream Video public API key (same value as the backend's STREAM_API_KEY)
VITE_STREAM_API_KEY=
# Public URL of this frontend, used to build shareable meeting links (defaults to window.location.origin)
VITE_BASE_URL=http://localhost:3000
# Backend URL. Leave empty in dev to use the Vite proxy (/api -> http://localhost:8080)
VITE_API_URL=
